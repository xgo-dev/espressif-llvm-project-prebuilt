# Source revision and payload identity for the LLGo Espressif LLVM toolchain.
# Keep the payload revision separate so packaging-only fixes do not pretend to
# be a different upstream LLVM revision.
# Official LLVM 23.1.4 plus the ESP port and null pointer vector emission fix
# maintained by xgo-dev. Vector emission preserves scalar assembly directives.
ESP_LLVM_SOURCE_REPOSITORY=https://github.com/xgo-dev/llvm-project
# Annotated source tag at merged commit ac20bc743f30452a911d43def1cf57a5bbba655a.
ESP_LLVM_SOURCE_REF=esp-23.1.4_20261027.1
ESP_LLVM_EXPECTED_VERSION=23.1.4
ESP_LLVM_PAYLOAD_VERSION=23.1.4_20261027.1
ESP_LLVM_PATCHES=""

# Espressif's public LLVM 22 build scripts provide the supported MinGW cross
# build. Pin the exact source revision and the LLVM 23 llvm-mingw bootstrap so
# Windows payloads do not depend on a moving branch or the runner image.
ESP_LLVM_BUILD_SCRIPTS_REPOSITORY=https://github.com/espressif/esp-llvm-embedded-toolchain
ESP_LLVM_BUILD_SCRIPTS_REF=ec164e9e48594ba66b1816cb200a345c5acdc9ec
LLVM_MINGW_VERSION=20261020
LLVM_MINGW_LINUX_X86_64_SHA256=55064b60b991a1e1e8090b8c2f84e82b22cfe5903d12c159d65064cf5e8ae335
LLVM_MINGW_WINDOWS_I686_SHA256=8e8eaf7f0c178ffe0582a5d871dbf3ac50f0a54d71cf5d5edb2e3634f6f9f002
ESP_LLVM_BUILD_SCRIPTS_PATCHES="patches/build-scripts/0001-select-native-mingw-host.patch"

# LLGo's Windows/386 host compiler needs development libraries independently
# of the ESP executable payload. Use the same fixed LLVM source with the
# pinned LLVM 23 llvm-mingw bootstrap and validate its native C/C++ APIs.
LLVM_WINDOWS_SDK_VERSION=23.1.4
LLVM_WINDOWS_SDK_REPOSITORY=https://github.com/xgo-dev/llvm-project.git
LLVM_WINDOWS_SDK_REF=ac20bc743f30452a911d43def1cf57a5bbba655a
