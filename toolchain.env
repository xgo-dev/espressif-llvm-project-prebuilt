# Source revision and payload identity for the LLGo Espressif LLVM toolchain.
# Keep the payload revision separate so packaging-only fixes do not pretend to
# be a different upstream LLVM revision.
ESP_LLVM_SOURCE_REPOSITORY=https://github.com/espressif/llvm-project
ESP_LLVM_SOURCE_REF=esp-22.1.4_20260825
ESP_LLVM_EXPECTED_VERSION=22.1.4
ESP_LLVM_PAYLOAD_VERSION=22.1.4_20261030
ESP_LLVM_PATCHES="patches/0001-Xtensa-accept-schedule-regions.patch patches/0002-export-shared-tool-interfaces.patch"

# Espressif's public LLVM 22 build scripts provide the supported MinGW cross
# build. Pin the exact source revision and the LLVM 22 llvm-mingw bootstrap so
# Windows payloads do not depend on a moving branch or the runner image.
ESP_LLVM_BUILD_SCRIPTS_REPOSITORY=https://github.com/espressif/esp-llvm-embedded-toolchain
ESP_LLVM_BUILD_SCRIPTS_REF=ec164e9e48594ba66b1816cb200a345c5acdc9ec
LLVM_MINGW_VERSION=20260616
LLVM_MINGW_LINUX_X86_64_SHA256=534b92e067b22a6b4441f48ae9240a3341b17825d04d577eab0cf85c44b4deda
LLVM_MINGW_WINDOWS_I686_SHA256=c68b26561883d5c7f33307aeb2b9b6c188eb705808b3f780dfce0be49f4e835d
ESP_LLVM_BUILD_SCRIPTS_PATCHES="patches/build-scripts/0001-select-native-mingw-host.patch patches/build-scripts/0002-share-llvm-in-mingw-tools.patch"

# The compiler's Go bindings need development libraries independently of the
# ESP executable payload. Official LLVM 22 provides no native Windows x86 SDK.
# Deliberately match LLGo's other host SDKs at upstream 22.1.8. ESP's separate
# 22.1.4 tools run out of process and do not share the host SDK's LLVM libraries.
LLVM_WINDOWS_SDK_VERSION=22.1.8
LLVM_WINDOWS_SDK_REPOSITORY=https://github.com/llvm/llvm-project.git
LLVM_WINDOWS_SDK_REF=ca7933e47d3a3451d81e72ac174dcb5aa28b59d1
